# Database
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/GuidED
DATABASE_NAME=GuidED

# AI & LLM Providers
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Bootstrap
INITIAL_ADMIN_EMAIL=admin@guided.app
INITIAL_ADMIN_PASSWORD=AdminPass123!Secure

# Google Calendar & Google Meet Integration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
GOOGLE_CALENDAR_ID=primary

# Transactional Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=GuidEd Mentorship <notifications@guided.app>
SMTP_ENABLED=false
